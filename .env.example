# Copy to .env for local runs. On Vercel, set these in Project Settings > Environment Variables.
# Declared and checked in src/env.ts.

# testnet (default) or mainnet. Picks the economy contract, the RPC, the MetaMask network and the
# explorer links. Mainnet uses economy.pixelclimb.near and https://rpc.mainnet.fastnear.com.
NEAR_NETWORK=testnet

# Optional overrides of the network's defaults
# ECONOMY_CONTRACT=economy.pixelclimb.testnet
# NEAR_RPC_URL=https://test.rpc.fastnear.com

# Game server: the `server` account on the economy contract, and its function-call key
# (ed25519:…). Without these the page still shows the round, but runs and revives return 503.
NEAR_SERVER_ACCOUNT=
NEAR_SERVER_KEY=
